{
  "name": "brainfuck-studio-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck:app && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "tauri": "tauri",
    "e2e:bridge": "cargo build --manifest-path ../../Cargo.toml -p brainfuck-e2e-bridge",
    "e2e:shim": "vite build --config e2e/support/ipcShim/vite.config.ts",
    "e2e:prepare": "npm run build && npm run e2e:bridge && npm run e2e:shim",
    "e2e": "npm run e2e:prepare && playwright test --project=chromium",
    "e2e:perf": "npm run e2e:prepare && playwright test --project=perf",
    "e2e:run": "playwright test",
    "e2e:webview:prepare": "tauri build --debug --no-bundle",
    "e2e:webview:run": "node e2e/support/webview/cli.ts",
    "e2e:webview": "npm run e2e:webview:prepare && npm run e2e:webview:run"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
